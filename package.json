{
  "name": "webspeak-webclient",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "node scripts/patch-teamspeak-sdk.mjs",
    "web:dev": "cd web && npx vite --host",
    "web:build": "cd web && npx vite build"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@honeybbq/teamspeak-client": "^0.2.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
